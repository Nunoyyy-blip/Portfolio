@{
    ViewData["Title"] = "Randy B. Manlangit | Backend Developer Portfolio";
    ViewData["Description"] = "Aspiring backend developer specializing in ASP.NET Core, C#, and modern web technologies.";
}
<style>
    /* ========================================
                   COMPACT SKILLS CARDS (MAS MALIIT ANG BOX)
                   ALL SECTIONS: 100vh FULL SCREEN
                ======================================== */

    * {
        margin: 0;
        padding: 0;
        box-sizing: border-box;
    }

    html {
        scroll-behavior: smooth;
    }

    body {
        font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif;
        background-color: #F5F5F5;
        color: #4A4A4A;
    }

    /* ========================================
                   COMPACT SKILLS CARDS - MAS MALIIT
                ======================================== */

    .skill-card {
        transition: all 0.3s ease-in-out;
        background: #FFFFFF !important;
        border-radius: 16px !important;
        border: 1px solid #E0E0E0 !important;
        height: 100%;
        min-height: 300px;
        max-height: 320px;
        display: flex;
        flex-direction: column;
    }

        .skill-card .card-body {
            display: flex;
            flex-direction: column;
            flex: 1;
            padding: 1.2rem !important;
        }

        /* Compact text area */
        .skill-card .card-text {
            flex: 1;
            margin-bottom: 0.75rem;
            font-size: 0.75rem;
            line-height: 1.4;
            color: #6c757d;
        }

        .skill-card:hover {
            transform: translateY(-4px);
            box-shadow: 0 8px 20px rgba(0,0,0,0.08) !important;
            border-color: #3498db !important;
        }

    .skill-icon {
        transition: transform 0.3s ease;
        font-size: 2rem !important;
        margin-bottom: 0.5rem;
    }

    .skill-card:hover .skill-icon {
        transform: scale(1.05);
    }

    /* Compact progress bar */
    .skill-progress {
        margin-top: 0.5rem;
        margin-bottom: 0.5rem;
    }

    .progress-bar-custom {
        height: 4px;
        background: #E0E0E0;
        border-radius: 10px;
        overflow: hidden;
        margin-top: 6px;
    }

    .progress-fill {
        height: 100%;
        border-radius: 10px;
        background: linear-gradient(90deg, #3498db, #2ecc71);
        width: 0%;
        transition: width 1s ease-out;
    }

    .skill-stats {
        display: flex;
        justify-content: space-between;
        align-items: center;
        margin-top: 6px;
    }

    .skill-level {
        font-size: 0.6rem;
        font-weight: 600;
        color: #3498db;
        background: #E8F4FD;
        padding: 2px 8px;
        border-radius: 20px;
    }

    .skill-percentage {
        font-size: 0.65rem;
        font-weight: 700;
        color: #2c3e50;
    }

    .skill-badge-new {
        background: linear-gradient(135deg, #3498db20, #2ecc7120);
        color: #3498db;
        font-size: 0.6rem;
        padding: 3px 8px;
        border-radius: 20px;
        font-weight: 600;
        display: inline-block;
        margin-top: 6px;
    }

    .skill-card .card-title {
        font-size: 1rem;
        font-weight: 700;
        margin-bottom: 0.5rem;
        color: #2c3e50;
    }

    /* ========================================
                   SECTION TITLE
                ======================================== */

    .section-title {
        position: relative;
        display: inline-block;
        color: #3A3A3A;
        font-size: 2rem;
    }

        .section-title::after {
            content: '';
            position: absolute;
            bottom: -10px;
            left: 50%;
            transform: translateX(-50%);
            width: 50px;
            height: 3px;
            background: linear-gradient(90deg, #3498db, #2ecc71);
            border-radius: 3px;
        }

    /* ========================================
                   ANIMATIONS
                ======================================== */

    @@keyframes fadeInUp {
        from

    {
        opacity: 0;
        transform: translateY(30px);
    }

    to {
        opacity: 1;
        transform: translateY(0);
    }

    }

    .fade-in-up {
        animation: fadeInUp 0.6s ease-out forwards;
    }

    @@keyframes blink {
        0%, 100%

    {
        opacity: 1;
    }

    50% {
        opacity: 0;
    }

    }

    @@keyframes float {
        0%, 100%

    {
        transform: translateY(0);
    }

    50% {
        transform: translateY(-8px);
    }

    }

    @@keyframes bounce {
        0%, 100%

    {
        transform: translateX(-50%) translateY(0);
    }

    50% {
        transform: translateX(-50%) translateY(6px);
    }

    }

    /* ========================================
                   ALL SECTIONS - 100vh FULL SCREEN
                ======================================== */

    .hero-section {
        min-height: 100vh;
        background: linear-gradient(135deg, #E8E8E8 0%, #F2F2F2 100%);
        position: relative;
        display: flex;
        align-items: center;
        justify-content: center;
        padding: 60px 0;
        overflow: hidden;
    }

    .skills-section {
        min-height: 100vh;
        background: linear-gradient(135deg, #F8F8F8 0%, #FFFFFF 100%);
        display: flex;
        align-items: center;
        padding: 50px 0;
        position: relative;
    }

        .skills-section::before {
            content: '';
            position: absolute;
            top: 0;
            left: 0;
            right: 0;
            height: 3px;
            background: linear-gradient(90deg, #3498db, #2ecc71, #3498db);
        }

    .projects-section {
        min-height: 100vh;
        background: #F5F5F5;
        display: flex;
        align-items: center;
        padding: 60px 0;
    }

    .cta-section {
        min-height: 100vh;
        background: linear-gradient(135deg, #2c3e50 0%, #1a252f 100%);
        display: flex;
        align-items: center;
        padding: 60px 0;
        position: relative;
    }

    /* ========================================
                   BUTTONS & BADGES
                ======================================== */

    .btn-soft-primary {
        background: linear-gradient(135deg, #9E9E9E, #8A8A8A);
        color: #FFFFFF;
        font-weight: 500;
        transition: all 0.3s ease;
        border: none;
        padding: 10px 28px;
        border-radius: 50px;
        text-decoration: none;
        display: inline-block;
        font-size: 0.9rem;
    }

        .btn-soft-primary:hover {
            background: linear-gradient(135deg, #8A8A8A, #7A7A7A);
            transform: translateY(-2px);
            box-shadow: 0 6px 14px rgba(0,0,0,0.1);
            color: #FFFFFF;
        }

    .btn-soft-outline {
        background: transparent;
        color: #7A7A7A;
        border: 2px solid #C8C8C8;
        font-weight: 500;
        transition: all 0.3s ease;
        padding: 10px 28px;
        border-radius: 50px;
        text-decoration: none;
        display: inline-block;
        font-size: 0.9rem;
    }

        .btn-soft-outline:hover {
            background: #E8E8E8;
            color: #4A4A4A;
            transform: translateY(-2px);
            border-color: #B0B0B0;
        }

    .badge-soft {
        background: #EDEDED;
        color: #5A5A5A;
        font-size: 0.7rem;
        padding: 5px 12px;
        border-radius: 50px;
        display: inline-flex;
        align-items: center;
        gap: 5px;
        border: 1px solid #E0E0E0;
        transition: all 0.2s ease;
    }

        .badge-soft:hover {
            background: #3498db;
            color: white;
            transform: translateY(-2px);
        }

    /* Hero Card */
    .hero-card {
        max-width: 300px;
        margin: 0 auto;
    }

    .stat-box {
        background: #F5F5F5;
        border-radius: 12px;
        transition: all 0.3s ease;
        padding: 8px;
        border: 1px solid #EBEBEB;
    }

        .stat-box:hover {
            background: #EFEFEF;
            transform: scale(1.02);
        }

    .floating {
        animation: float 3s ease-in-out infinite;
    }

    /* Scroll Indicator */
    .scroll-indicator {
        position: absolute;
        bottom: 20px;
        left: 50%;
        transform: translateX(-50%);
        text-align: center;
        cursor: pointer;
        animation: bounce 2s infinite;
    }

        .scroll-indicator a {
            opacity: 0.5;
            transition: opacity 0.3s;
            text-decoration: none;
            color: #A0A0A0;
            font-size: 0.8rem;
        }

            .scroll-indicator a:hover {
                opacity: 0.8;
            }

    /* Typography */
    .typed-text {
        color: #3498db;
        font-weight: 500;
    }

    .cursor {
        display: inline-block;
        width: 2px;
        background-color: #9A9A9A;
        margin-left: 2px;
        animation: blink 1s infinite;
    }

    .cta-section h2,
    .cta-section .display-5,
    .cta-section .lead,
    .cta-section .badge.bg-light {
        color: #FFFFFF !important;
    }

    /* Responsive */
    @@media (max-width: 768px) {
        .hero-section, .skills-section, .projects-section, .cta-section

    {
        min-height: auto;
        padding: 50px 0;
    }

    .display-4 {
        font-size: 1.6rem !important;
    }

    .hero-card {
        margin-top: 30px;
    }

    .btn-soft-primary, .btn-soft-outline {
        padding: 8px 18px;
        font-size: 0.8rem;
    }

    .section-title {
        font-size: 1.6rem;
    }

    .skill-card {
        min-height: 280px;
        max-height: 300px;
    }

    }

    @@media (max-width: 576px) {
        .display-4

    {
        font-size: 1.4rem !important;
    }

    }
</style>

